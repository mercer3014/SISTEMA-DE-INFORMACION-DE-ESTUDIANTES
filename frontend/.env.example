# Nombre visible del sistema (se incrusta al compilar; en Docker es build arg)
NEXT_PUBLIC_APP_NAME=Estudiantes

# URL INTERNA de la API Rust; sólo la usa el servidor de Next (route handler /api/*).
#   local: http://localhost:8080 · Docker/Dokploy: http://estudiantes-api:8080
API_INTERNAL_URL=http://localhost:8080
# Si la API exige x-api-key, póngala aquí (se queda en el servidor, nunca va al navegador)
API_KEY=

# Autenticación HTTP Basic para todo el sitio (vacío = desactivada).
# Hash: printf '%s' 'la-clave' | sha256sum | cut -d' ' -f1
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD_SHA256=

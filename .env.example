# =====================================================================
# Variables del sistema "Estudiantes". Copie a .env y complete; .env NUNCA se versiona.
# Producción (Docker Swarm):  set -a; . ./.env; set +a
#                              docker stack deploy -c docker-compose.yml --with-registry-auth estudiantes
# Use comillas SIMPLES en valores con '$' (p. ej. los hashes htpasswd).
# =====================================================================

# ---- Imágenes (GHCR) ----
# Tag fijo publicado por GitHub Actions: sha-<commit corto>, p. ej. sha-1a2b3c4
IMAGE_TAG=

# ---- Base de datos (estudiantes-db) ----
POSTGRES_DB=estudiantes
POSTGRES_USER=estudiantes
# Genérela en el VPS: openssl rand -hex 24   (sólo [0-9a-zA-Z]: va dentro de una URL)
POSTGRES_PASSWORD=

# ---- Acceso público (Traefik) ----
# Usuarios htpasswd para el middleware basicauth de Traefik (bcrypt recomendado):
#   htpasswd -nbB usuario 'clave'          (o: docker run --rm httpd:2.4-alpine htpasswd -nbB usuario 'clave')
# Escríbalo entre comillas simples aquí, o expórtelo en el shell. NO lo ponga en el compose.
TRAEFIK_BASIC_AUTH_USERS=

# ---- API Rust (estudiantes-api; sólo red interna) ----
# Clave compartida API ↔ frontend (header x-api-key). Genérela: openssl rand -hex 32
API_KEY=
CORS_ORIGINS=https://estudiantes.nickzar.online
DB_MAX_CONNECTIONS=10
# Nº de migraciones que deben estar aplicadas antes de atender (database/migrations)
MIN_MIGRACIONES=8
RUST_LOG=info

# ---- Frontend (estudiantes-frontend) ----
# Basic auth propia de Next.js, OPCIONAL (vacías = desactivada; ya protege Traefik).
#   BASIC_AUTH_PASSWORD_SHA256: printf '%s' 'clave' | sha256sum | cut -d' ' -f1
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD_SHA256=
# Nombre visible: se fija AL COMPILAR la imagen (variable de repositorio APP_NAME en
# GitHub Actions, o build arg). Aquí sólo sirve para builds locales.
NEXT_PUBLIC_APP_NAME=Estudiantes

# ---- Scraper (estudiantes-scraper) ----
SCRAPER_CONCURRENCY=6
SCRAPER_TARGET_CONCURRENCY=3
SCRAPER_DELAY=0.2
SCRAPER_LOTE=300
SCRAPER_LOG_LEVEL=INFO
# 1 = empezar aunque la BD esté vacía (si no, espera a que se restaure el dump)
SCRAPER_INICIAR_VACIA=0

# ---- Sólo desarrollo local (scripts/*.sh, sin Docker) ----
DATABASE_URL=postgres://estudiantes:CAMBIAR@localhost:5432/estudiantes
API_BIND=0.0.0.0:8080
# Binarios de PostgreSQL 17 si no están en el PATH
PGBIN=
PGDATA=

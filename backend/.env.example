DATABASE_URL=postgres://estudiantes:CAMBIAR@localhost:5432/estudiantes
API_BIND=0.0.0.0:8080
# Orígenes permitidos (CORS), separados por coma. "*" = cualquiera.
# Con el proxy same-origin del frontend (/api/*) el navegador no llama a la API directamente.
CORS_ORIGINS=http://localhost:3000
# Opcional: exige el header x-api-key en /api/* (excepto /api/health)
API_KEY=
DB_MAX_CONNECTIONS=10
RUST_LOG=info
